{
  "name": "ai-test-guardrails",
  "version": "1.0.0",
  "description": "MCP server providing deterministic guardrails for AI-generated test automation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jch1887/ai-test-guardrails.git"
  },
  "homepage": "https://github.com/jch1887/ai-test-guardrails#readme",
  "bugs": {
    "url": "https://github.com/jch1887/ai-test-guardrails/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ai-test-guardrails": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run format:check && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "test-automation",
    "guardrails",
    "playwright",
    "cypress",
    "flake-detection",
    "ast-analysis"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "typescript": "^5.7.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
